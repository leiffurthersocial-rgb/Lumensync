{
  "name": "lumensync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-libraw.mjs",
    "dev": "node scripts/copy-libraw.mjs && next dev",
    "build": "node scripts/copy-libraw.mjs && next build && node scripts/build-sw.mjs",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.20",
    "idb": "^8.0.4",
    "libraw-wasm": "^1.6.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "fake-indexeddb": "^6.2.5",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
